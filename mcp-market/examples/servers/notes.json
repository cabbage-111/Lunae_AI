{
  "name": "com.acme/notes",
  "version": "0.4.1",
  "description": "Per-tenant notes workspace over HTTP.",
  "publisher": {
    "namespace": "com.acme",
    "displayName": "Acme",
    "url": "https://acme.com",
    "verifiedBy": "dns-txt"
  },
  "run": {
    "type": "http",
    "url": "https://mcp.acme.com/{tenant}/mcp"
  },
  "variables": [
    {
      "name": "tenant",
      "description": "Your Acme tenant slug"
    }
  ],
  "permissions": {
    "network": ["mcp.acme.com"]
  }
}
