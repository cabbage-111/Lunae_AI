# =======Production-mode web build config (local closed loop)=======
# `npm run build:web` runs vite in production mode, which only reads
# .env.production / .env / .env.local — never .env.development.
# Without the Stack keys below the Login page throws
# "useStackApp must be used within a StackProvider" and renders a blank page.
# Values are kept aligned with .env.development so the built bundle talks to
# the local server (server/, FastAPI on :3001) instead of the cloud backend.
# This file is gitignored; it only affects `npm run build:web`.

VITE_BASE_URL=http://localhost:4173

SERVER_URL=http://localhost:3001
VITE_PROXY_URL=http://localhost:4173
VITE_USE_LOCAL_PROXY=true
VITE_REMOTE_CONTROL_WEB_ORIGIN=http://localhost:4173
REMOTE_CONTROL_WEB_ORIGIN=http://localhost:4173
VITE_REMOTE_CONTROL_LOCAL_API_URL=http://localhost:3001

# Brain endpoint for pure-web builds. Points at this preview origin so Brain
# requests stay same-origin and travel through `preview.proxy` in
# vite.config.web.ts. Change the port here if you preview on a different one.
VITE_BRAIN_ENDPOINT=http://localhost:4173

VITE_SITE_URL=https://www.eigent.ai

# Stack Auth placeholder keys. hasStackKeys() reads these at build time; when
# they are missing the app skips <StackProvider> and the login route crashes.
VITE_STACK_PROJECT_ID=dummy_project_id
VITE_STACK_PUBLISHABLE_CLIENT_KEY=dummy_publishable_key
VITE_STACK_SECRET_SERVER_KEY=dummy_secret_server_key
